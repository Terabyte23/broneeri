# PocketBase public URL (lokaalselt: http://127.0.0.1:8090, või Coolify / VPS aadress)
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Stripe Payment Link (Test või Live režiim)
# Loo Stripe Dashboardis Payment Link ja kleepige siia
# Näide: https://buy.stripe.com/test_...
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_12345

# Stripe Publishable Key (valikuline)
# Näide: pk_test_51...
VITE_STRIPE_PUBLIC_KEY=pk_test_51...

# Stripe Secret Key (vajalik node server.js allkirja valideerimiseks)
# Näide: sk_test_51...
STRIPE_SECRET_KEY=

# Stripe Webhook Secret (saadakse Stripe Dashboard -> Webhooks -> Signing secret)
# Näide: whsec_...
STRIPE_WEBHOOK_SECRET=

# Webhook serveri port (vaikimisi 3001)
WEBHOOK_PORT=3001
